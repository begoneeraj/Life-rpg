// Life RPG — Prisma schema
// Postgres hosted on Supabase (free tier). Connection string comes from DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  // Nullable so existing accounts (created before the friends/battle system)
  // aren't broken by the migration; set at signup for new accounts, or via
  // PATCH /api/users/username to backfill an old one. Only usernamed users
  // are searchable/challengeable.
  username     String?    @unique
  createdAt    DateTime   @default(now())
  character    Character?
  quests       Quest[]
  weeklyTasks  WeeklyTask[]
  refreshTokens RefreshToken[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipReceiver")
  battlesChallenged      Battle[]     @relation("BattleChallenger")
  battlesOpposed         Battle[]     @relation("BattleOpponent")
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | accepted | rejected
  createdAt   DateTime @default(now())

  @@unique([requesterId, receiverId])
  @@index([receiverId])
}

// A 1v1 productivity duel between two friends over a shared task list.
model Battle {
  id               String       @id @default(uuid())
  challengerId     String
  challenger       User         @relation("BattleChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId       String
  opponent         User         @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  status           String       @default("pending") // pending | active | completed | declined
  timeLimitMinutes Int
  startedAt        DateTime?
  endedAt          DateTime?
  winnerId         String? // null while pending/active, or on a tie once completed
  createdAt        DateTime     @default(now())
  tasks            BattleTask[]

  @@index([challengerId])
  @@index([opponentId])
}

model BattleTask {
  id                    String    @id @default(uuid())
  battleId              String
  battle                Battle    @relation(fields: [battleId], references: [id], onDelete: Cascade)
  round                 Int       @default(1) // 1 | 2 | 3 - every battle is best-of-3 rounds
  taskText              String
  challengerCompletedAt DateTime?
  opponentCompletedAt   DateTime?

  @@index([battleId])
}

model Character {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level          Int       @default(1)
  currentXP      Int       @default(0)
  gold           Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  strength   Int @default(0)
  intellect  Int @default(0)
  discipline Int @default(0)
  focus      Int @default(0)
  energy     Int @default(0)

  createdCharacter Boolean @default(false)
  gender           String  @default("male")
  physique         String  @default("athletic")
  skinTone         String  @default("medium")
  faceType         String  @default("friendly")
  eyeColor         String  @default("espresso_brown")
  hairStyle        String  @default("short_textured")
  hairColor        String  @default("black")
  facialHair       String  @default("clean_shaven")
  skinDetail       String  @default("none")

  equippedTop       String?
  equippedBottom    String?
  equippedShoes     String?
  equippedAccessory String?
  equippedSpecial   String?

  // Two-channel garment dye, independent per equipment slot. Null means
  // "use the item's default colors" (the STYLES baked into Top/Bottom/Shoes)
  // - these are optional overrides the player picks after equipping, not
  // set at character creation like the rest of the fields above.
  topPrimaryColor    String?
  topAccentColor     String?
  bottomPrimaryColor String?
  bottomAccentColor  String?
  shoesPrimaryColor  String?
  shoesAccentColor   String?

  inventory InventoryItem[]
  updatedAt DateTime        @updatedAt
}

model Item {
  id            String   @id @default(uuid())
  name          String
  category      String // top | bottom | shoes | accessory | special | hair | facial_hair
  rarity        String // common | uncommon | rare | epic | legendary | mythic
  price         Int
  requiredLevel Int      @default(1)
  svgKey        String
  genderScope   String   @default("unisex") // male | female | unisex
  isStarter     Boolean  @default(false)
  createdAt     DateTime @default(now())

  inventoryOf InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(uuid())
  userId      String
  character   Character @relation(fields: [userId], references: [userId], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  purchasedAt DateTime  @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

model Quest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String // "coding" | "gym" | "study" | "creative" -> maps to attribute; AI-classified, not user-picked
  difficulty  String // "easy" | "medium" | "hard" -> AI-assigned descriptive label, no longer drives XP directly
  estimatedMinutes Int @default(15) // AI-estimated task length; xpEngine.xpForMinutes() computes XP from this
  status      String    @default("pending") // pending | completed
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// A recurring weekly schedule slot ("do X every Monday") - separate from the
// one-off AI-classified Quest system. dayOfWeek follows the IST calendar
// (0=Sunday..6=Saturday, see xpEngine.toDayOfWeek) so "today" always means
// the same day regardless of server timezone. Editable any time (title or
// day can change); completion is tracked per specific calendar occurrence
// via WeeklyTaskCompletion, not on the slot itself, so "did I do Monday's
// task this week" resets automatically next Monday.
model WeeklyTask {
  id          String                 @id @default(uuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  dayOfWeek   Int // 0=Sunday, 1=Monday, ... 6=Saturday
  createdAt   DateTime               @default(now())
  completions WeeklyTaskCompletion[]

  @@index([userId])
}

model WeeklyTaskCompletion {
  id           String     @id @default(uuid())
  weeklyTaskId String
  weeklyTask   WeeklyTask @relation(fields: [weeklyTaskId], references: [id], onDelete: Cascade)
  dateKey      String // YYYY-MM-DD (Asia/Kolkata) - the specific occurrence this completion is for
  completedAt  DateTime   @default(now())

  @@unique([weeklyTaskId, dateKey])
}

// Refresh tokens are persisted so they can be revoked on logout / rotated safely.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
}
