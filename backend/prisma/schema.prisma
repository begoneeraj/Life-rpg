// Life RPG — Prisma schema
// Postgres hosted on Supabase (free tier). Connection string comes from DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  character    Character?
  quests       Quest[]
  refreshTokens RefreshToken[]
}

model Character {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level          Int       @default(1)
  currentXP      Int       @default(0)
  gold           Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?

  strength   Int @default(0)
  intellect  Int @default(0)
  discipline Int @default(0)
  focus      Int @default(0)
  energy     Int @default(0)

  createdCharacter Boolean @default(false)
  gender           String  @default("male")
  physique         String  @default("athletic")
  skinTone         String  @default("medium")
  faceType         String  @default("friendly")
  eyeColor         String  @default("espresso_brown")
  hairStyle        String  @default("short_textured")
  hairColor        String  @default("black")
  facialHair       String  @default("clean_shaven")
  skinDetail       String  @default("none")

  equippedTop       String?
  equippedBottom    String?
  equippedShoes     String?
  equippedAccessory String?
  equippedSpecial   String?

  // Two-channel garment dye, independent per equipment slot. Null means
  // "use the item's default colors" (the STYLES baked into Top/Bottom/Shoes)
  // - these are optional overrides the player picks after equipping, not
  // set at character creation like the rest of the fields above.
  topPrimaryColor    String?
  topAccentColor     String?
  bottomPrimaryColor String?
  bottomAccentColor  String?
  shoesPrimaryColor  String?
  shoesAccentColor   String?

  inventory InventoryItem[]
  updatedAt DateTime        @updatedAt
}

model Item {
  id            String   @id @default(uuid())
  name          String
  category      String // top | bottom | shoes | accessory | special | hair | facial_hair
  rarity        String // common | uncommon | rare | epic | legendary | mythic
  price         Int
  requiredLevel Int      @default(1)
  svgKey        String
  genderScope   String   @default("unisex") // male | female | unisex
  isStarter     Boolean  @default(false)
  createdAt     DateTime @default(now())

  inventoryOf InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(uuid())
  userId      String
  character   Character @relation(fields: [userId], references: [userId], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  purchasedAt DateTime  @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

model Quest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String // "coding" | "gym" | "study" | "creative" -> maps to attribute
  difficulty  String // "easy" | "medium" | "hard" -> maps to base XP
  status      String    @default("pending") // pending | completed
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Refresh tokens are persisted so they can be revoked on logout / rotated safely.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@index([userId])
}
