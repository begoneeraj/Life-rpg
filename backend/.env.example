# Template file: copy to .env and fill in real values.
# Supabase Postgres connection string.
# In Supabase: Project Settings -> Database -> Connection string -> "Transaction" pooler (port 6543)
# is recommended for serverless/Render deployments; use the "Session" pooler or direct connection
# (port 5432) for local `prisma migrate dev`. Append ?pgbouncer=true&connection_limit=1 when using
# the pooled (6543) connection string with Prisma.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Secrets used to sign JWTs. Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT values so a leaked access secret can't be used to forge refresh tokens.
JWT_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# Port the Express server listens on. Render sets its own PORT env var automatically in production.
PORT=4000

# "development" enables verbose Prisma logging and relaxed (non-HTTPS) cookie settings for
# localhost. Set to "production" on Render.
NODE_ENV=development

# Comma-separated list of origins allowed to call this API with credentials (cookies).
# Include your deployed Vercel URL in production, e.g.:
#   CORS_ORIGIN=http://localhost:5173,https://life-rpg.vercel.app
CORS_ORIGIN=http://localhost:5173

# Groq API key for AI quest analysis (POST /api/analyze-quest). Get one free at
# https://console.groq.com/keys
GROQ_API_KEY=
